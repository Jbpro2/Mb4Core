#!/bin/bash

# Cores
VERDE='\e[32m'
RESET='\e[0m'
VERMELHO='\e[31m'
CIANO='\e[36m'

echo -e "${VERDE}Iniciando instalação do DTunnel Mod (Mb4Core)...${RESET}"

# Verificar se é root
if [ "$EUID" -ne 0 ]; then 
  echo -e "${VERMELHO}Por favor, execute como root (sudo su).${RESET}"
  exit
fi

# Atualizar sistema
apt update -y && apt upgrade -y

# Instalar dependências básicas
echo -e "${VERDE}Instalando dependências do sistema e Java...${RESET}"
apt install -y curl git zip unzip wget screen build-essential libcap2-bin python3 python3-pip python3-bcrypt openjdk-17-jdk-headless

# Instalar Node.js 20
if ! command -v node &> /dev/null; then
    echo -e "${VERDE}Instalando Node.js...${RESET}"
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt install -y nodejs
fi

# Dar permissão para o Node usar portas privilegiadas
setcap 'cap_net_bind_service=+ep' $(which node)

# Instalar PM2 globalmente
if ! command -v pm2 &> /dev/null; then
    echo -e "${VERDE}Instalando PM2...${RESET}"
    npm install -g pm2
fi

# --- INSTALAÇÃO DO ANDROID SDK PARA GERAR APK ---
echo -e "${VERDE}Configurando Android SDK para geração de APK...${RESET}"
mkdir -p /opt/android-sdk/cmdline-tools
cd /opt/android-sdk/cmdline-tools
if [ ! -d "latest" ]; then
    wget https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O tools.zip
    unzip tools.zip
    mv cmdline-tools latest
    rm tools.zip
fi

export ANDROID_HOME=/opt/android-sdk
export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

# Aceitar licenças
yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=$ANDROID_HOME "platform-tools" "platforms;android-33" "build-tools;33.0.2"

# Criar local.properties no projeto
mkdir -p /opt/Mb4Core
echo "sdk.dir=/opt/android-sdk" > /opt/Mb4Core/local.properties

# -----------------------------------------------

# Limpar instalação anterior se existir
rm -rf /opt/Mb4Core

# Clonar o repositório
echo -e "${VERDE}Baixando arquivos do projeto...${RESET}"
git clone https://github.com/Jbpro2/Mb4Core.git /opt/Mb4Core

# Entrar na pasta do projeto
cd /opt/Mb4Core

# Configurar local.properties novamente após o clone
echo "sdk.dir=/opt/android-sdk" > /opt/Mb4Core/local.properties
chmod +x gradlew

# Criar arquivo .env
echo -e "${VERDE}Gerando chaves de segurança...${RESET}"
cat <<EOF > .env
PORT=3000
NODE_ENV="production"
DATABASE_URL="file:./database.db"
CSRF_SECRET="$(openssl rand -hex 32)"
JWT_SECRET_KEY="$(openssl rand -hex 32)"
JWT_SECRET_REFRESH="$(openssl rand -hex 32)"
EOF

# Instalar dependências do projeto
echo -e "${VERDE}Instalando dependências do Node.js...${RESET}"
npm install

# Sincronizar banco de dados com Prisma
echo -e "${VERDE}Configurando banco de dados...${RESET}"
npx prisma db push --accept-data-loss

# Criar usuário administrador via Python
python3 setup_admin.py

# Build do projeto
echo -e "${VERDE}Compilando o projeto...${RESET}"
npm run build

# Configurar atalhos
sed -i '/menuop/d' ~/.bashrc
sed -i '/pon/d' ~/.bashrc
sed -i '/poff/d' ~/.bashrc

echo "alias menuop='bash /opt/Mb4Core/menu.sh'" >> ~/.bashrc
echo "alias pon='cd /opt/Mb4Core && pm2 start ecosystem.config.js'" >> ~/.bashrc
echo "alias poff='pm2 stop DTunnel'" >> ~/.bashrc

# Criar comandos globais
cat <<EOF > /usr/local/bin/menuop
#!/bin/bash
bash /opt/Mb4Core/menu.sh
EOF

cat <<EOF > /usr/local/bin/pon
#!/bin/bash
cd /opt/Mb4Core && pm2 start ecosystem.config.js
EOF

cat <<EOF > /usr/local/bin/poff
#!/bin/bash
pm2 stop DTunnel
EOF

chmod +x /usr/local/bin/menuop
chmod +x /usr/local/bin/pon
chmod +x /usr/local/bin/poff

# Iniciar o painel
cd /opt/Mb4Core && pm2 start ecosystem.config.js

echo -e "${VERDE}Instalação concluída com sucesso!${RESET}"
echo -e "Acesse pelo seu IP na porta 3000"
echo -e "Admin padrão: ${VERDE}Bk2026@12${RESET} / Senha: ${VERDE}2012@bk2520${RESET}"
echo ""
echo -e "Use os comandos abaixo:"
echo -e "- ${VERDE}menuop${RESET} : Abre o menu"
echo -e "- ${VERDE}pon${RESET}    : Liga o painel"
echo -e "- ${VERDE}poff${RESET}   : Desliga o painel"
